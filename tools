    def check_anchor(self):
        a = self.feature_anchor.get("1.0", "end-1c")
        if not self.disk: self.anchor_status.config(text="Open a source file to check anchors.", foreground="#666666"); return
        if not a: self.anchor_status.config(text="Enter an anchor.", foreground="#666666"); return
        try: base = self.render_base()
        except Exception: base = strip_dev_patches(self.disk)
        n = base.count(a)
        if n == 1: self.anchor_status.config(text="✔ Anchor matches exactly once (line %d of the unpatched source)." % (base[:base.find(a)].count("\n") + 1), foreground="#2e7d32")
        elif n == 0: self.anchor_status.config(text="✖ Anchor not found in the source.", foreground="#b00020")
        else: self.anchor_status.config(text="✖ Anchor occurs %d times — make it longer so it is unique." % n, foreground="#b00020")

    def new_feature_patch(self):
        self.feature_id.set("custom_feature"); self.feature_position.set("before")
        self.feature_anchor.delete("1.0", "end"); self.feature_code.delete("1.0", "end"); self.feature_tree.selection_remove(self.feature_tree.selection()); self.check_anchor()

    def load_feature_template(self):
        data = copy.deepcopy(FEATURE_TEMPLATES.get(self.feature_template.get(), FEATURE_TEMPLATES["Custom patch"]))
        self.feature_id.set(data["id"]); self.feature_position.set(data["position"])
        self.feature_anchor.delete("1.0", "end"); self.feature_anchor.insert("1.0", data["anchor"])
        self.feature_code.delete("1.0", "end"); self.feature_code.insert("1.0", data["code"]); self.check_anchor()

    def refresh_feature_tree(self):
        if not hasattr(self, "feature_tree"): return
        self.feature_tree.delete(*self.feature_tree.get_children())
        for i, patch in enumerate(self.dev_patches): self.feature_tree.insert("", "end", iid=str(i), values=(patch["id"], patch["position"], patch["anchor"].replace("\n", "\\n")[:180]))

    def select_feature_patch(self, _event=None):
        sel = self.feature_tree.selection()
        if not sel: return
        patch = self.dev_patches[int(sel[0])]
        self.feature_id.set(patch["id"]); self.feature_position.set(patch["position"])
        self.feature_anchor.delete("1.0", "end"); self.feature_anchor.insert("1.0", patch["anchor"])
        self.feature_code.delete("1.0", "end"); self.feature_code.insert("1.0", patch["code"]); self.check_anchor()

    def upsert_feature_patch(self):
        if not self.require_source("Open a C++ source file first."): return
        patch = {"id": self.feature_id.get().strip(), "position": self.feature_position.get(), "anchor": self.feature_anchor.get("1.0", "end-1c"), "code": self.feature_code.get("1.0", "end-1c")}
        existing = next((i for i, p in enumerate(self.dev_patches) if p["id"] == patch["id"]), None)
        candidate = copy.deepcopy(self.dev_patches)
        if existing is None: candidate.append(patch)
        else: candidate[existing] = patch
        try:
            apply_dev_patches(self.render_base(), candidate)
            for pattern in BANNED:
                if re.search(pattern, patch["code"]): raise ValueError("This patch contains a construct forbidden by the game's BUILD NOTES: " + pattern)
        except Exception as e: messagebox.showerror("Patch not accepted", str(e), parent=self); return
        self.dev_patches = candidate; self.refresh_feature_tree(); self.changed()
        self.flash("Patch '%s' %s." % (patch["id"], "added" if existing is None else "updated"))

    def remove_feature_patch(self):
        sel = self.feature_tree.selection()
        if not sel: return
        patch = self.dev_patches[int(sel[0])]
        if not messagebox.askyesno("Remove patch", "Remove gameplay patch '%s'?" % patch["id"], parent=self): return
        del self.dev_patches[int(sel[0])]; self.refresh_feature_tree(); self.changed(); self.flash("Patch removed.")

