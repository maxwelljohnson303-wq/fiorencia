def selftest(path):
    src = Path(path).read_text(encoding="utf-8")
    errors = lexical_cpp_check(src)
    base = strip_dev_patches(src)
    for label, anchor, kind in VANILLA_BLOCKS:
        try:
            locate_vanilla_block(base, anchor, kind)
        except ValueError as e:
            errors.append(f"{label}: {e}")
    if base.count(BEGIN) != base.count(END): errors.append("Unbalanced mod-zone delimiters.")
    if base.count(BEGIN) > 1 or base.count(END) > 1: errors.append("Duplicate mod-zone delimiters.")
    markers = PATCH_RE.findall(src)
    if len(markers) != len(set(markers)): errors.append("Duplicate MODPATCH marker(s).")
    dev_ids = [x["id"] for x in parse_dev_patches(src)]
    if len(dev_ids) != len(set(dev_ids)): errors.append("Duplicate DEVPATCH ids.")
    # Verify source patches can be stripped and re-applied without changing their content.
    try:
        rebuilt = apply_dev_patches(base, parse_dev_patches(src))
        if strip_dev_patches(rebuilt) != base: errors.append("Development patch round-trip changed unpatched source.")
    except ValueError as e:
        errors.append(str(e))
    if errors:
        print("SELFTEST FAIL")
        for e in errors: print(" -", e)
        return 1
    print("SELFTEST OK: source anchors, lexical delimiters, patch IDs, and patch round-trip checks passed.")
    print("Note: this is a structural check, not a C++ compile or gameplay test.")
    return 0


