    def refresh_raw(self, force=False):
        if self.raw is None: return
        if not force and self._current_tab_key() != "raw": return
        diff = bool(self.diffvar.get()) and bool(self.path); key = (self._rev, diff, str(self.path))
        if not force and key == self._raw_key: return
        self._raw_key = key; self._find_pos = "1.0"
        if not self.path: text = "(Open a Fiorencia C++ source file to preview generated source.)"
        else:
            src, err = self.get_preview()
            if err: text, diff = "PREVIEW ERROR: " + err, False
            elif diff:
                text = "".join(difflib.unified_diff(self.disk.splitlines(True), src.splitlines(True), fromfile="disk", tofile="preview")) or "(No differences vs. disk.)"
            else: text = src
        w = self.raw; w.configure(state="normal"); w.delete("1.0", "end"); w.insert("1.0", text)
        if diff: colorize_diff(w, text)
        w.configure(state="disabled")
        if diff: a, d = diff_counts(text); self.raw_stats.config(text="+%d / -%d lines" % (a, d))
        else: self.raw_stats.config(text="%d lines" % (text.count("\n") + 1))

    def show_diff(self):
        self.diffvar.set(True); self.select_tab("raw"); self.refresh_raw(force=True)

    def _jump_change(self, direction):
        if not self.diffvar.get(): self.diffvar.set(True); self.refresh_raw(force=True)
        w = self.raw; starts = [str(r) for r in w.tag_ranges("hunk")][::2]
        if not starts: self.flash("No changes versus disk."); return
        cur = w.index("@0,0")
        if direction > 0: cand = [s for s in starts if w.compare(s, ">", cur)]; target = cand[0] if cand else starts[0]
        else: cand = [s for s in starts if w.compare(s, "<", cur)]; target = cand[-1] if cand else starts[-1]
        w.yview(target)

    def find_next(self):
        q = self.find_var.get()
        if not q or self.raw is None: return
        w = self.raw; w.tag_remove("find", "1.0", "end")
        pos = w.search(q, self._find_pos, stopindex="end", nocase=True) or w.search(q, "1.0", stopindex="end", nocase=True)
        if not pos: self.flash("Not found: " + q); return
        end = "%s+%dc" % (pos, len(q)); w.tag_add("find", pos, end); w.see(pos); self._find_pos = end

    def goto_line_from_entry(self):
        try: self.goto_preview_line(int(self.goto_var.get()), switch=False)
        except ValueError: self.flash("Enter a line number.")

    def goto_preview_line(self, n, switch=True):
        if switch:
            self.diffvar.set(False); self.select_tab("raw")
        self.refresh_raw(force=True)
        w = self.raw; w.tag_remove("target", "1.0", "end"); idx = "%d.0" % max(1, n)
        w.tag_add("target", idx, "%d.end" % max(1, n)); w.yview("%d.0-3l" % max(1, n))

    def copy_preview(self):
        self.clipboard_clear(); self.clipboard_append(self.raw.get("1.0", "end-1c")); self.flash("Copied to clipboard.")


def main():
    ap = argparse.ArgumentParser(description="Fiorencia Development Workbench")
    ap.add_argument("--version", action="version", version="Fiorencia Development Workbench " + WORKBENCH_VERSION)
    ap.add_argument("source", nargs="?", help="Fiorencia C++ source file (.cpp)")
    ap.add_argument("--selftest", nargs="?", const="", help="validate source structure and patch markers")
    ns = ap.parse_args()
    if ns.selftest is not None:
        target = ns.selftest or ns.source
        if not target: ap.error("--selftest needs a source path (or pass the source as positional argument)")
        return selftest(target)
    app = Editor(ns.source); app.mainloop(); return 0


if __name__ == "__main__": raise SystemExit(main())

