        for line in ("", "FEATURE DEPENDENCIES", "- Save/load changes: inspect Player fields, fields() serialization, saveGame(), and loadGame().", "- New spells: inspect spell definitions, combat/casting, spell info/status displays, shop/acquisition, and save compatibility.",
                     "- Shop items: inspect SHOP inventory and doBuy purchase/display logic.", "- Consumables: inspect doUse and inventory quantity handling.", "- Enemies: inspect makeEnemy, plot/encounter selection, combat, and reward handling.",
                     "- Quest/dialogue content: inspect doQuest, plotBeat, dialogue transitions, and reachable branches.", "", "VALIDATION LEVELS",
                     "1. Design validation: field presence, value ranges, unique IDs.", "2. Static source validation: lexical balance, anchors, patch markers, known forbidden constructs.",
                     "3. Compiler validation: only after explicit Build Release / Build Debug.", "4. Gameplay acceptance: manual tests still required; build success does not establish balance or save compatibility."):
            add(line, "h" if line.isupper() else None)
        return L

