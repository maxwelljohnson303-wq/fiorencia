def inject_zone(src,bundle):
    zone=mod_zone(bundle)
    if BEGIN in src and END in src:
        a=src.index(BEGIN); b=src.index(END,a)+len(END)
        return src[:a]+zone.rstrip()+src[b:]
    if BEGIN in src or END in src: raise ValueError("Malformed mod-zone delimiters")
    anchor="int main(int argc, char **argv) {"
    p=src.find(anchor)
    if p<0: raise ValueError("Cannot find main() anchor")
    return src[:p]+zone+"\n"+src[p:]

def validate(src,bundle):
    errors=[]
    if (BEGIN in src)!=(END in src): errors.append("Only one mod-zone delimiter is present.")
    if BEGIN in src and src.count(BEGIN)!=1: errors.append("Duplicate mod-zone begin delimiter.")
    if END in src and src.count(END)!=1: errors.append("Duplicate mod-zone end delimiter.")
    checked = src[src.find(BEGIN):src.find(END)+len(END)] if BEGIN in src and END in src else ""
    for pat in BANNED:
        if re.search(pat,checked): errors.append("Banned C++ construct/include detected in mod zone: "+pat)
    markers=PATCH_RE.findall(src)
    if len(markers)!=len(set(markers)): errors.append("A MODPATCH marker appears more than once.")
    for i,x in enumerate(bundle.get("enemies",[])):
        if int(x.get("plot",0))<0 or int(x.get("plot",0))>7: errors.append(f"Enemy {i}: plot bitmask must be 0..7.")
    for i,x in enumerate(bundle.get("scenes",[])):
        if int(x.get("plot",-1)) not in (0,1,2): errors.append(f"Scene {i}: plot must be 0, 1, or 2.")
        if not (0 <= int(x.get("dialogIdx",-1)) < len(bundle.get("dialogs",[]))): errors.append(f"Scene {i}: dialogIdx out of range.")
    for i,x in enumerate(bundle.get("quests",[])):
        for key,lim in (("enemyIdx",len(bundle.get("enemies",[]))),("dialogIdx",len(bundle.get("dialogs",[])))):
            n=int(x.get(key,-1))
            if n != -1 and not 0 <= n < lim: errors.append(f"Quest {i}: {key} out of range.")
    for i,x in enumerate(bundle.get("dialogs",[])):
        for n in x.get("next",[]):
            if int(n) not in (-2,-1) and not 0 <= int(n) < len(bundle.get("dialogs",[])): errors.append(f"Dialogue {i}: next index {n} out of range.")
    return errors

def locate_vanilla_block(src, anchor, kind):
    """Find an editable source block and return (start, end, exact source text)."""
    pos = src.find(anchor)
    # Backward compatibility: older Fiorencia builds used a fixed SPL name
    # array instead of the extensible SpellDef catalog.
    if pos < 0 and anchor == "static const SpellDef SPELLS[] = {":
        legacy_anchor = "static const char *SPL["
        legacy_pos = src.find(legacy_anchor)
        if legacy_pos >= 0:
            anchor = legacy_anchor
            pos = legacy_pos
    if pos < 0:
        raise ValueError("Missing source anchor: " + anchor)
    if kind == "line":
        start = src.rfind("\n", 0, pos) + 1
        end = src.find("\n", pos)
        if end < 0: end = len(src)
        else: end += 1
        return start, end, src[start:end]
    if kind == "function":
        brace = src.find("{", pos)
        if brace < 0: raise ValueError("Missing function body: " + anchor)
        end = matching_brace_end(src, brace)
        while end < len(src) and src[end] in " \t\r": end += 1
        if end < len(src) and src[end] == "\n": end += 1
        return pos, end, src[pos:end]
    return parse_initializer(src, anchor)

def apply_vanilla_edits(src, edits):
    """Apply source edits against original offsets, from the end to avoid offset drift."""
    ranges = []
    for label, replacement in edits.items():
        spec = next((x for x in VANILLA_BLOCKS if x[0] == label), None)
        if spec is None: raise ValueError("Unknown vanilla block: " + label)
        start, end, original = locate_vanilla_block(src, spec[1], spec[2])
        if start < end: ranges.append((start, end, replacement, label))
    ranges.sort(key=lambda x: x[0])
    for a, b in zip(ranges, ranges[1:]):
        if a[1] > b[0]: raise ValueError("Overlapping source edits: " + a[3] + " / " + b[3])
    for start, end, replacement, label in reversed(ranges):
        src = src[:start] + replacement + src[end:]
    return src

DEVPATCH_BEGIN_RE = re.compile(
    r"// \[DEVPATCH:([A-Za-z0-9_-]+):(before|after):([A-Za-z0-9_-]+):BEGIN\]\n(.*?)// \[DEVPATCH:\1:END\]\n?",
    re.DOTALL,
)


def _anchor_encode(anchor):
    return base64.urlsafe_b64encode(anchor.encode("utf-8")).decode("ascii").rstrip("=")


def _anchor_decode(value):
    return base64.urlsafe_b64decode(value + "=" * (-len(value) % 4)).decode("utf-8")


def parse_dev_patches(src):
    """Read editable source patches embedded in the C++ file itself."""
    patches = []
    for m in DEVPATCH_BEGIN_RE.finditer(src):
        try:
            anchor = _anchor_decode(m.group(3))
        except Exception:
            continue
        patches.append({"id": m.group(1), "position": m.group(2), "anchor": anchor,
                        "code": m.group(4).rstrip("\r\n")})
    return patches


def strip_dev_patches(src):
    # An "after" patch adds one separator newline before its marker; remove that
    # separator too, otherwise every open/save cycle would accumulate blank lines.
    pieces = []
    cursor = 0
    for match in DEVPATCH_BEGIN_RE.finditer(src):
        prefix = src[cursor:match.start()]
        if match.group(2) == "after" and prefix.endswith("\n"):
            prefix = prefix[:-1]
        pieces.append(prefix)
        cursor = match.end()
    pieces.append(src[cursor:])
    return "".join(pieces)


def apply_dev_patches(src, patches):
    """Apply named, idempotent insertions. Each anchor must exist exactly once."""
    base = strip_dev_patches(src)
    seen = set()
    for patch in patches:
        pid = str(patch.get("id", "")).strip()
        anchor = str(patch.get("anchor", ""))
        position = patch.get("position", "before")
        code = str(patch.get("code", "")).rstrip("\r\n")
        if not re.fullmatch(r"[A-Za-z0-9_-]{1,48}", pid):
            raise ValueError(f"Invalid patch id {pid!r}; use letters, digits, _ or - (max 48).")
        if pid in seen:
            raise ValueError(f"Duplicate development patch id: {pid}")
        seen.add(pid)
        if not anchor or base.count(anchor) != 1:
            count = base.count(anchor) if anchor else 0
            raise ValueError(f"Patch {pid}: anchor must occur exactly once in source (found {count}).")
        if position not in ("before", "after"):
            raise ValueError(f"Patch {pid}: position must be before or after.")
        if not code.strip():
            raise ValueError(f"Patch {pid}: code cannot be empty.")
        block = (f"// [DEVPATCH:{pid}:{position}:{_anchor_encode(anchor)}:BEGIN]\n"
                 f"{code}\n// [DEVPATCH:{pid}:END]\n")
        idx = base.find(anchor)
        if position == "before":
            base = base[:idx] + block + base[idx:]
        else:
            end = idx + len(anchor)
            base = base[:end] + "\n" + block + base[end:]
    return base


def lexical_cpp_check(src):
    """Small lexer for delimiter/string sanity; not a C++ parser."""
    state = "code"; stack = []; i = 0; line = 1
    pairs = {"}": "{", ")": "(", "]": "["}
    while i < len(src):
        c = src[i]; n = src[i + 1] if i + 1 < len(src) else ""
        if c == "\n": line += 1
        if state == "code":
            if c == '"': state = "string"
            elif c == "'": state = "char"
            elif c == "/" and n == "/": state = "line"; i += 1
            elif c == "/" and n == "*": state = "block"; i += 1
            elif c in "{([": stack.append((c, line))
            elif c in "})]":
                if not stack or stack[-1][0] != pairs[c]:
                    return [f"Unexpected {c!r} on line {line}."]
                stack.pop()
        elif state == "string":
            if c == "\\": i += 1
            elif c == '"': state = "code"
        elif state == "char":
            if c == "\\": i += 1
            elif c == "'": state = "code"
        elif state == "line":
            if c == "\n": state = "code"
        elif state == "block":
            if c == "*" and n == "/": state = "code"; i += 1
        i += 1
    errors = []
    if state in ("string", "char", "block"):
        errors.append(f"Unterminated C++ {state} literal/comment.")
    if stack:
        errors.append(f"Unclosed delimiter {stack[-1][0]!r} opened on line {stack[-1][1]}.")
    return errors


def validate_workbench_source(src, bundle):
    errors = list(validate(src, bundle))
    errors.extend(lexical_cpp_check(src))
    patches = parse_dev_patches(src)
    ids = [p["id"] for p in patches]
    if len(ids) != len(set(ids)): errors.append("Duplicate development patch IDs.")
    for patch in patches:
        for pattern in BANNED:
            if re.search(pattern, patch["code"]):
                errors.append(f"Patch {patch['id']}: forbidden construct detected ({pattern}).")
    return list(dict.fromkeys(errors))


