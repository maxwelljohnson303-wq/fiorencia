        except Exception as e: messagebox.showerror("Save failed", str(e), parent=self); return False
        self.design_dirty = False; self._update_title(); self.refresh_review(); self.update_status()
        if not quiet: messagebox.showinfo("Designs saved", "Saved %d design(s) to:\n%s\n\nThese are planning specifications; they do not change the game's C++ source." % (len(self.designs), p), parent=self)
        return True

