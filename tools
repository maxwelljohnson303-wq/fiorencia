def cpp_string(s):
    return '"' + str(s).replace('\\','\\\\').replace('"','\\"').replace('\n','\\n').replace('\r','\\r').replace('\t','\\t') + '"'

def matching_brace_end(src, opening):
    """Return index just after matching brace, ignoring C++ strings and comments."""
    depth=0; i=opening; state='code'
    while i < len(src):
        c=src[i]; n=src[i+1] if i+1<len(src) else ''
        if state=='code':
            if c=='"' : state='string'
            elif c=="'" : state='char'
            elif c=='/' and n=='/': state='line'; i+=1
            elif c=='/' and n=='*': state='block'; i+=1
            elif c=='{': depth+=1
            elif c=='}':
                depth-=1
                if depth==0: return i+1
        elif state=='string':
            if c=='\\': i+=1
            elif c=='"': state='code'
        elif state=='char':
            if c=='\\': i+=1
            elif c=="'": state='code'
        elif state=='line':
            if c=='\n': state='code'
        elif state=='block':
            if c=='*' and n=='/': state='code'; i+=1
        i+=1
    raise ValueError("unbalanced C++ braces")

def parse_initializer(src, anchor):
    pos=src.find(anchor)
    # The extensible source replaced the fixed SPL name array with a
    # SpellDef catalog. Keep the legacy anchor as a fallback so older
    # Fiorencia source versions remain editable by the same workbench.
    if pos < 0 and anchor == "static const SpellDef SPELLS[] = {":
        legacy_anchor = "static const char *SPL["
        legacy_pos = src.find(legacy_anchor)
        if legacy_pos >= 0:
            anchor = legacy_anchor
            pos = legacy_pos
    if pos<0: raise ValueError("Missing anchor: "+anchor)
    brace=src.find('{',pos)
    if brace<0: raise ValueError("Missing initializer brace: "+anchor)
    end=matching_brace_end(src,brace)
    while end<len(src) and src[end].isspace(): end+=1
    if end<len(src) and src[end]==';': end+=1
    return pos,end,src[pos:end]

