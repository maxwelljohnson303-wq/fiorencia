    def _update_title(self):
        name = self.path.name if self.path else "untitled"
        self.title(("* " if (self.dirty or self.design_dirty) else "") + name + " — Fiorencia Development Workbench")

    def _bundle_has_data(self):
        return any(self.bundle.get(k) for k in SECTIONS)

    def update_status(self):
        src, _err = self.get_preview() if self.path else (None, None)
        errs = self.get_validation()
        zone = BEGIN in (src or self.disk)
        valid = "no source" if errs is None else ("checks OK" if not errs else "%d issue(s)" % len(errs))
        if self.build_running: build = "building…"
        elif self.built_binary: build = "build current" if self._build_is_current() else "build STALE"
        else: build = "no build"
        name = self.path.name if self.path else "no file"
        self._status_default = "%s — %d staged edit(s), %d patch(es), %d design(s)" % (name, len(self.vanilla_edits), len(self.dev_patches), len(self.designs))
        self.status_right.config(text="Mod zone: %s | %s | %s | Saved: %s" % ("yes" if zone else "no", valid, build, self.saved_at))
        if not self._flash_job: self.status.config(text=self._status_default)
        self.build_state_text()

    def build_state_text(self):
        if not hasattr(self, "build_state_label"): return
        if self.build_running: t = "Building…"
        elif self.built_binary: t = "Binary is up to date" if self._build_is_current() else "Binary is OLDER than your edits (rebuild)"
        else: t = self.build_state
        self.build_state_label.config(text=t)

    def _build_is_current(self):
        src, err = self.get_preview()
        return bool(src) and self.build_hash == hashlib.sha1(src.encode("utf-8")).hexdigest()

    def changed(self):
        self.dirty = True; self._rev += 1
        self.dirtylabel.config(text="● Unsaved changes", style="Dirty.TLabel")
        self._update_title(); self._vanilla_refresh_list()
        self.refresh_raw(); self.update_status(); self.refresh_review()

    def _touch(self):
        self._rev += 1

    # ------------------------------------------------------------ render pipeline (engine calls unchanged)
    def render_base(self):
        if not self.path: raise ValueError("Open a source file first.")
        clean = strip_dev_patches(self.disk)
        base = apply_vanilla_edits(clean, self.vanilla_edits) if self.vanilla_edits else clean
        if self._bundle_has_data(): base = inject_zone(base, self.bundle)
        return base

    def render(self):
        base = self.render_base()
        return apply_dev_patches(base, self.dev_patches) if self.dev_patches else base

    def get_preview(self):
        if self._preview_cache[0] == self._rev: return self._preview_cache[1], self._preview_cache[2]
        try: src, err = self.render(), None
        except Exception as e: src, err = None, str(e)
        self._preview_cache = (self._rev, src, err)
        return src, err

    def get_validation(self):
        if not self.path: return None
        if self._validation_cache[0] == self._rev: return self._validation_cache[1]
        src, err = self.get_preview()
        if err: errs = ["Source preview failed: " + err]
        else:
            try: errs = validate_workbench_source(src, self.bundle)
            except Exception as e: errs = ["Validation could not run (check mod data values): " + str(e)]
        self._validation_cache = (self._rev, errs); return errs

    # ------------------------------------------------------------ file handling
    def _default_source(self):
        """Choose a sensible first source while preserving the user's last-opened file."""
        last = self.settings.get("last_file")
        if last and Path(last).exists():
            return last

        # Prefer the human-readable extensible edition when the workbench sits
        # beside it. Keep older project layouts supported as fallbacks.
        names = (
            "fiorencia_extensible_readable.cpp",
            "fiorencia_extensible.cpp",
            "fiorencia.cpp",
        )
        roots = (Path(__file__).resolve().parent, Path.cwd())
        seen = set()
        for root in roots:
            for name in names:
                candidate = root / name
                key = str(candidate.resolve())
                if key in seen:
                    continue
                seen.add(key)
                if candidate.is_file():
                    return str(candidate)
        return None

    def _read_source(self, path):
        p = Path(path).resolve()
        text, eol, raw = read_source_text(p)
        mt = p.stat().st_mtime_ns
        self.path, self.disk, self.eol, self.disk_bytes, self.disk_mtime = p, text, eol, raw, mt
        self._ext_warned = False

    def load_file(self, path):
        try: self._read_source(path)
        except Exception as e:
            messagebox.showerror("Open failed", str(e), parent=self); return False
        self.vanilla_edits = {}; self.current_vanilla_label = None; self.session_backup_done = False
        self.dev_patches = parse_dev_patches(self.disk); self.dirty = False; self._touch()
        self.filelabel.config(text=str(self.path)); self._update_title()
        self.dirtylabel.config(text="● Saved", style="Clean.TLabel")
        self.refresh_feature_tree(); self.load_tuning_from_source(); self._vanilla_refresh_list()
        self.load_vanilla_block(VANILLA_BLOCKS[0][0], quiet=True)
        self.designs = []; self.design_dirty = False; self.current_design_index = None
        sidecar = self.path.with_suffix(".designs.json")
        if sidecar.exists():
            try:
                loaded = json.loads(sidecar.read_text(encoding="utf-8"))
                if loaded.get("format") == "fiorencia-item-designs-v1" and isinstance(loaded.get("designs"), list): self.designs = loaded["designs"]
            except Exception as e: messagebox.showwarning("Design sidecar not loaded", str(e), parent=self)
        self.refresh_design_tree(); self.new_item_design()
        bsc = self.path.with_suffix(".bundle.json")
        if bsc.exists() and not self._bundle_has_data():
            if messagebox.askyesno("Mod bundle found", "%s was saved next to the source.\nLoad it into Mod Content?" % bsc.name, parent=self):
                try:
                    self.bundle = self._read_bundle(bsc); self.bundle_file = bsc; self.zone_ack = True
                    self._touch(); src, err = self.get_preview()
                    if src is not None and src != self.disk: self.changed()
                except Exception as e: messagebox.showerror("Bundle error", str(e), parent=self)
        self.refresh_all(); self._remember_file()
        self.update_status(); self.refresh_raw(); self.refresh_review()
        self.flash("Opened %s (%s line endings)" % (self.path.name, "CRLF" if self.eol == "\r\n" else "LF"))
        return True

    def _remember_file(self):
        self.settings["last_file"] = str(self.path)
        rec = [p for p in self.settings.get("recent", []) if p != str(self.path)]
        self.settings["recent"] = ([str(self.path)] + rec)[:8]
        save_settings(self.settings); self._rebuild_recent()

    def _save_settings(self):
        try: self.settings["geometry"] = self.geometry()
        except Exception: pass
        self.settings["diff"] = bool(self.diffvar.get())
        if hasattr(self, "run_args"): self.settings["run_args"] = self.run_args.get()
        save_settings(self.settings)

    def _open_path(self, p):
        if self.confirm_discard("opening another file"): self.load_file(p)

    def open_file(self):
        if not self.confirm_discard("opening another file"): return
        init = str(self.path.parent) if self.path else self.settings.get("last_dir", str(Path.cwd()))
        p = filedialog.askopenfilename(title="Open Fiorencia source", initialdir=init, filetypes=[("C++ source", "*.cpp"), ("All files", "*.*")])
        if p: self.settings["last_dir"] = str(Path(p).parent); self.load_file(p)

    def reload(self):
        if self.path and self.confirm_discard("reloading"): self.load_file(self.path)

    def revert(self):
        if not self.path: return
        bak = Path(str(self.path) + ".bak")
        if not bak.exists(): messagebox.showinfo("Revert", "No .bak file exists.", parent=self); return
        if not messagebox.askyesno("Revert", "Replace the current source with the latest .bak?\n(The file as it is now is not backed up again.)", parent=self): return
        shutil.copy2(bak, self.path); self.load_file(self.path)

    def confirm_discard(self, action):
        if not (self.dirty or self.design_dirty or self._vanilla_unapplied()): return True
        ans = messagebox.askyesnocancel("Unsaved changes", "You have unsaved changes. Save them before %s?" % action, parent=self)
        if ans is None: return False
        if not ans: return True
        if not self.path:
            self.export_item_designs(); return not self.design_dirty
        return bool(self.save())

    def quit_app(self):
        if not self.confirm_discard("quitting"): return
        if self.proc and self.proc.poll() is None: self.proc.terminate()
        self._save_settings(); self.destroy()

    def _on_focus(self, e):
        if e.widget is not self or not self.path: return
        now = time.time()
        if now - self._last_focus_check < 1.0: return
        self._last_focus_check = now
        try: mt = self.path.stat().st_mtime_ns
        except OSError: return
        if mt == self.disk_mtime: return
        if self.dirty or self._vanilla_unapplied():
            if not self._ext_warned:
                self._ext_warned = True; self.flash("⚠ %s changed on disk. Saving will ask before overwriting it." % self.path.name, 15000)
            return
        try: self._read_source(self.path)
        except Exception as ex: self.flash("Could not re-read source: %s" % ex); return
        self.vanilla_edits = {}; self.dev_patches = parse_dev_patches(self.disk); self._touch()
        self.refresh_feature_tree(); self.load_tuning_from_source(); self._vanilla_refresh_list()
        if self.current_vanilla_label: self.load_vanilla_block(self.current_vanilla_label, quiet=True)
        self.update_status(); self.refresh_raw(); self.refresh_review()
        self.flash("%s changed on disk — reloaded." % self.path.name, 9000)

    # ------------------------------------------------------------ saving
    def save(self):
        if not self.path: return self.save_as()
        if not self._vanilla_resolve_pending(): return False
        parts = []
        if self.dirty:
            if not self._do_save(self.path): return False
            parts.append("source saved (backup: %s.bak)" % self.path.name)
        else: parts.append("no source changes")
        if self.design_dirty and self._write_designs(self.path.with_suffix(".designs.json"), quiet=True): parts.append("designs saved")
        self.update_status(); self.flash("; ".join(parts).capitalize() + ". Press F5 to build.", 9000)
        return True

    def save_as(self):
        if not self.disk: messagebox.showinfo("Save As", "Open a source file first.", parent=self); return False
        p = filedialog.asksaveasfilename(title="Save source as", defaultextension=".cpp", initialdir=str(self.path.parent) if self.path else None, filetypes=[("C++ source", "*.cpp")])
        if not p: return False
        if not self._vanilla_resolve_pending(): return False
        if self._do_save(Path(p).resolve(), as_new=True): self.update_status(); self.flash("Saved as %s" % Path(p).name); return True
        return False

    def _do_save(self, target, as_new=False):
        src, err = self.get_preview()
        if err: messagebox.showerror("Save blocked", "Preview failed:\n" + err, parent=self); return False
        errors = validate_workbench_source(src, self.bundle)
        if errors:
            self.select_tab("review"); self.refresh_review(force=True)
            messagebox.showerror("Validation failed", "Save blocked:\n\n" + "\n".join(errors[:12]) + ("\n…" if len(errors) > 12 else "") + "\n\nThe Review tab lists a hint for each issue.", parent=self); return False
        if BEGIN in self.disk and self._bundle_has_data() and not self.zone_ack:
            if not messagebox.askyesno("Replace existing MOD ZONE?", "This source already contains a MOD ZONE. Saving regenerates it from the Mod Content tabs only; anything not in your bundle is removed.\n\nTip: Load the matching bundle first (File > Load Mod Bundle). Continue?", icon="warning", parent=self): return False
            self.zone_ack = True
        if not as_new and target.exists() and target.stat().st_mtime_ns != self.disk_mtime:
            if not messagebox.askyesno("File changed on disk", "%s was modified outside the workbench after it was opened.\nOverwrite those changes with your staged edits? (A .bak of the current file is made first.)" % target.name, icon="warning", parent=self): return False
        try:
            if target.exists():
                current = target.read_bytes()
                Path(str(target) + ".bak").write_bytes(current)
                if not self.session_backup_done:
                    Path("%s.%s.bak" % (target, datetime.now().strftime("%Y%m%d-%H%M%S"))).write_bytes(current); self.session_backup_done = True
            data = to_disk_text(src, self.eol).encode("utf-8")
            tmp = target.with_name(target.name + ".tmp"); tmp.write_bytes(data); os.replace(str(tmp), str(target))
            if self._bundle_has_data():
                bp = target.with_suffix(".bundle.json"); self._write_bundle(bp); self.bundle_file = bp
        except Exception as e:
            messagebox.showerror("Save failed", str(e), parent=self); return False
        self.path = target; self.disk = src; self.disk_bytes = data; self.disk_mtime = target.stat().st_mtime_ns; self._ext_warned = False
        self.vanilla_edits = {}; self.dev_patches = parse_dev_patches(src); self.dirty = False
        self.saved_at = datetime.now().strftime("%H:%M:%S"); self._touch()
        self.filelabel.config(text=str(self.path)); self.dirtylabel.config(text="● Saved", style="Clean.TLabel")
        self.refresh_feature_tree(); self.load_tuning_from_source(); self._vanilla_refresh_list()
        if self.current_vanilla_label: self.load_vanilla_block(self.current_vanilla_label, quiet=True)
        self._update_title(); self.refresh_raw(); self.refresh_review(); self.refresh_all(); self._remember_file()
        return True

    # ------------------------------------------------------------ 1. Existing content
    def _vanilla_tab(self, frame):
        ttk.Label(frame, text="Edit existing C++ blocks in place. Pick a block on the left, edit, then Apply (Ctrl+Enter). Edits are staged and only written when you Save; red ● marks staged blocks. Raw C++ edits can break compilation or save compatibility, so check Preview / Diff.", wraplength=1100, style="Muted.TLabel").pack(anchor="w", padx=10, pady=(10, 4))
        pw = ttk.Panedwindow(frame, orient="horizontal"); pw.pack(fill="both", expand=True, padx=8, pady=4)
        left = ttk.Frame(pw); right = ttk.Frame(pw); pw.add(left, weight=1); pw.add(right, weight=4)
        self.vanilla_filter = tk.StringVar()
        frow = ttk.Frame(left); frow.pack(fill="x", pady=(0, 3)); ttk.Label(frow, text="Filter:").pack(side="left")
        ttk.Entry(frow, textvariable=self.vanilla_filter).pack(side="left", fill="x", expand=True, padx=4)
        lbf = ttk.Frame(left); lbf.pack(fill="both", expand=True)
        self.vanilla_list = tk.Listbox(lbf, exportselection=False, activestyle="none", width=34)
        ls = ttk.Scrollbar(lbf, orient="vertical", command=self.vanilla_list.yview); self.vanilla_list.configure(yscrollcommand=ls.set)
        self.vanilla_list.pack(side="left", fill="both", expand=True); ls.pack(side="right", fill="y")
        self.vanilla_list.bind("<<ListboxSelect>>", self._vanilla_select)
        self.vanilla_filter.trace_add("write", lambda *_: self._vanilla_refresh_list())
        bar = ttk.Frame(right); bar.pack(fill="x")
        for text, cmd, tip in (("Apply (Ctrl+Enter)", self.apply_vanilla_block, "Stage this block's edit"), ("Revert editor", self.revert_vanilla_editor, "Discard unapplied typing"),
                               ("Restore original", self.restore_vanilla_block, "Drop the staged edit for this block"), ("Show block diff", self.show_vanilla_diff, "Original vs. editor text")):
            b = ttk.Button(bar, text=text, command=cmd); b.pack(side="left", padx=(0, 4)); Tip(b, tip)
        self.vanilla_info = ttk.Label(right, text="Open a source file to browse its blocks.", style="Muted.TLabel"); self.vanilla_info.pack(anchor="w", pady=4)
        fr, self.vanilla_text = scrolled_text(right, font=("TkFixedFont", 10), undo=True); fr.pack(fill="both", expand=True)
        self.vanilla_text.tag_configure("cmt", foreground="#6a8759"); self.vanilla_text.tag_configure("str", foreground="#b5651d")
        self.vanilla_text.bind("<KeyRelease>", self._vanilla_key); self.vanilla_text.bind("<<Paste>>", lambda e: self.after(50, self._vanilla_key))
        self.vanilla_text.bind("<Control-Return>", lambda e: (self.apply_vanilla_block(), "break")[1])
        self._vanilla_refresh_list()

    def _vanilla_spec(self, label):
        return next((x for x in VANILLA_BLOCKS if x[0] == label), None)

    def _vanilla_refresh_list(self):
        if not hasattr(self, "vanilla_list"): return
        flt = self.vanilla_filter.get().strip().lower()
        self.vanilla_visible = [b[0] for b in VANILLA_BLOCKS if flt in b[0].lower()]
        lb = self.vanilla_list; lb.delete(0, "end")
        for i, lab in enumerate(self.vanilla_visible):
            staged = lab in self.vanilla_edits
            lb.insert("end", ("● " if staged else "   ") + lab)
            if staged: lb.itemconfig(i, foreground="#b00020")
        if self.current_vanilla_label in self.vanilla_visible:
            i = self.vanilla_visible.index(self.current_vanilla_label); lb.selection_set(i); lb.see(i)

    def _vanilla_select(self, _e=None):
        sel = self.vanilla_list.curselection()
        if not sel: return
        label = self.vanilla_visible[sel[0]]
        if label == self.current_vanilla_label: return
        if not self._vanilla_resolve_pending():
            self._vanilla_refresh_list(); return
        self.load_vanilla_block(label)

    def _vanilla_unapplied(self):
        if not self.current_vanilla_label or not hasattr(self, "vanilla_text"): return False
        return self.vanilla_text.get("1.0", "end-1c").rstrip("\r\n") != self.vanilla_loaded_text.rstrip("\r\n")

    def _vanilla_resolve_pending(self):
        """True when it is safe to continue (nothing pending, applied, or discarded on request)."""
        if not self._vanilla_unapplied(): return True
        ans = messagebox.askyesnocancel("Unapplied edit", "'%s' has typing that was not applied.\n\nYes = apply it, No = discard it, Cancel = stay." % self.current_vanilla_label, parent=self)
        if ans is None: return False
        if ans: return self.apply_vanilla_block(quiet=True)
        self.revert_vanilla_editor(); return True

    def load_vanilla_block(self, label=None, quiet=False):
        if not self.path or not self.disk:
            if not quiet: messagebox.showinfo("Open source", "Open a Fiorencia C++ source file first.", parent=self)
            return
        label = label or self.current_vanilla_label or VANILLA_BLOCKS[0][0]
        spec = self._vanilla_spec(label)
        if not spec: return
        try: _s, _e, original = locate_vanilla_block(strip_dev_patches(self.disk), spec[1], spec[2])
        except Exception as e:
            self.vanilla_info.config(text="%s — anchor not found in this source: %s" % (label, e), style="Dirty.TLabel")
            if not quiet: messagebox.showerror("Cannot load block", str(e), parent=self)
            return
        current = self.vanilla_edits.get(label, original)
        self.current_vanilla_label, self.vanilla_original, self.vanilla_loaded_text = label, original, current
        self.vanilla_text.delete("1.0", "end"); self.vanilla_text.insert("1.0", current); self.vanilla_text.edit_reset()
        self._vanilla_highlight(); self._vanilla_update_info(); self._vanilla_refresh_list()

    def _vanilla_clear_editor(self):
        self.current_vanilla_label = None; self.vanilla_text.delete("1.0", "end"); self._vanilla_update_info()

    def _vanilla_update_info(self):
        lab = self.current_vanilla_label
        if not lab: self.vanilla_info.config(text="Select a block on the left.", style="Muted.TLabel"); return
        spec = self._vanilla_spec(lab); un = self._vanilla_unapplied()
        state = "UNAPPLIED typing: press Ctrl+Enter to stage it" if un else ("staged edit (written on Save)" if lab in self.vanilla_edits else "original source")
        self.vanilla_info.config(text="%s  [%s]  —  %s" % (lab, spec[2], state), style="Dirty.TLabel" if un else "Muted.TLabel")

    def _vanilla_key(self, _e=None):
        if self._hl_job: self.after_cancel(self._hl_job)
        self._hl_job = self.after(250, lambda: (self._vanilla_highlight(), self._vanilla_update_info()))

    def _vanilla_highlight(self):
        self._hl_job = None; t = self.vanilla_text
        for tag in ("cmt", "str"): t.tag_remove(tag, "1.0", "end")
        text = t.get("1.0", "end-1c")
        for m in re.finditer(r'(//[^\n]*|/\*.*?\*/)|("(?:\\.|[^"\\\n])*")', text, re.DOTALL):
            t.tag_add("cmt" if m.group(1) else "str", "1.0+%dc" % m.start(), "1.0+%dc" % m.end())

    def apply_vanilla_block(self, quiet=False):
        label = self.current_vanilla_label; spec = self._vanilla_spec(label) if label else None
        if not self.path or not spec:
            if not quiet: messagebox.showinfo("Open source", "Open a Fiorencia C++ source file and select a block first.", parent=self)
            return False
        new_text = self.vanilla_text.get("1.0", "end-1c")
        if not new_text.strip(): messagebox.showerror("Empty block", "A source block cannot be empty.", parent=self); return False
        try:
            base = strip_dev_patches(self.disk)
            _a, _b, original = locate_vanilla_block(base, spec[1], spec[2])
            if spec[2] in ("initializer", "function"):
                opening = new_text.find("{")
                if opening < 0: raise ValueError("Expected a C++ initializer/function body containing '{'.")
                end = matching_brace_end(new_text, opening)
                if spec[2] == "initializer" and ";" not in new_text[end:]: raise ValueError("Array declaration must retain its trailing semicolon.")
            elif "=" not in new_text or ";" not in new_text: raise ValueError("Constant declaration must retain '=' and ';'.")
            replacement = new_text.rstrip("\r\n")
            if spec[2] in ("line", "function"): replacement += "\n"
            candidate = dict(self.vanilla_edits)
            if replacement.rstrip("\r\n") == original.rstrip("\r\n"): candidate.pop(label, None)
            else: candidate[label] = replacement
            result = apply_vanilla_edits(base, candidate)
            errs = lexical_cpp_check(result)
            if errs: raise ValueError("This edit leaves the source structurally invalid: " + "; ".join(errs))
        except Exception as e:
            messagebox.showerror("Invalid source block", str(e), parent=self); return False
        was = dict(self.vanilla_edits); self.vanilla_edits = candidate; self.vanilla_loaded_text = new_text
        self._vanilla_update_info(); self._vanilla_refresh_list()
        if candidate != was: self.changed()
        self.flash(("Staged edit for “%s”. Save writes a .bak first." % label) if label in candidate else ("“%s” matches the original again; edit cleared." % label))
        return True

    def revert_vanilla_editor(self):
        if self.current_vanilla_label: self.load_vanilla_block(self.current_vanilla_label, quiet=True)

    def restore_vanilla_block(self):
        label = self.current_vanilla_label
        if label and label in self.vanilla_edits:
            del self.vanilla_edits[label]; self.load_vanilla_block(label, quiet=True); self.changed(); self.flash("Restored original “%s”." % label)

    def show_vanilla_diff(self):
        if not self.current_vanilla_label: return
        cur = self.vanilla_text.get("1.0", "end-1c")
        d = "".join(difflib.unified_diff(self.vanilla_original.splitlines(True), cur.splitlines(True), fromfile="original", tofile="editor"))
        if not d: self.flash("No differences from the original block."); return
        self.show_text_window("Block diff — " + self.current_vanilla_label, d, diff=True)

    def show_text_window(self, title, text, diff=False):
        win = tk.Toplevel(self); win.title(title); win.geometry("880x560"); win.transient(self)
        fr, t = scrolled_text(win, font=("TkFixedFont", 9)); fr.pack(fill="both", expand=True, padx=6, pady=6)
        config_diff_tags(t); t.insert("1.0", text)
        if diff: colorize_diff(t, text)
        t.configure(state="disabled")
        ttk.Button(win, text="Close", command=win.destroy).pack(pady=(0, 6)); win.bind("<Escape>", lambda e: win.destroy())

    # ------------------------------------------------------------ 2. Tuning
    def _tuning_tab(self, frame):
        ttk.Label(frame, text="Balance dials from the game's economy block. Values that differ from the source are marked ●. Apply stages the changes (nothing is written until Save); only values that really changed are staged.", wraplength=1100, style="Muted.TLabel").pack(anchor="w", padx=12, pady=(10, 4))
        self.tuning_vars, self.tuning_base, self.tuning_marks = {}, {}, {}
        grid = ttk.Frame(frame); grid.pack(anchor="nw", padx=12, pady=6, fill="x")
        for gi, (title, items) in enumerate(TUNING_GROUPS):
            box = ttk.LabelFrame(grid, text=title); box.grid(row=gi // 2, column=gi % 2, sticky="nsew", padx=6, pady=6)
            for r, (key, help_) in enumerate(items):
                ttk.Label(box, text=key, width=16).grid(row=r, column=0, sticky="w", padx=4, pady=2)
                sv = tk.StringVar(value=str(TUNING_DEFAULTS[key])); self.tuning_vars[key] = sv
                ttk.Spinbox(box, from_=-999999, to=999999, textvariable=sv, width=9).grid(row=r, column=1, padx=4, pady=2)
                mark = ttk.Label(box, text="", width=2, style="Dirty.TLabel"); mark.grid(row=r, column=2); self.tuning_marks[key] = mark
                ttk.Label(box, text=help_, style="Muted.TLabel").grid(row=r, column=3, sticky="w", padx=4)
                sv.trace_add("write", lambda *_a, k=key: self._tuning_mark(k))
        grid.columnconfigure(0, weight=1); grid.columnconfigure(1, weight=1)
        bar = ttk.Frame(frame); bar.pack(anchor="w", padx=12, pady=4)
        ttk.Button(bar, text="Apply tuning to source", command=self.apply_tuning_values).pack(side="left")
        ttk.Button(bar, text="Reload values from source", command=self.load_tuning_from_source).pack(side="left", padx=6)
        self.tuning_summary = ttk.Label(bar, text="", style="Muted.TLabel"); self.tuning_summary.pack(side="left", padx=10)

    def _tuning_mark(self, key):
        base = self.tuning_base.get(key)
        diff = base is not None and self.tuning_vars[key].get().strip() != base
        self.tuning_marks[key].config(text="●" if diff else "")
        n = sum(1 for k in self.tuning_vars if self.tuning_base.get(k) is not None and self.tuning_vars[k].get().strip() != self.tuning_base[k])
        self.tuning_summary.config(text="%d value(s) differ from source" % n if n else "")

    def load_tuning_from_source(self):
        if not hasattr(self, "tuning_vars") or not self.disk: return
        src = strip_dev_patches(self.disk)
        for key in TUNING_SCALAR:
            m = re.search(r"\b" + re.escape(key) + r"\s*=\s*(-?\d+)", src)
            if m and key in self.tuning_vars: self.tuning_vars[key].set(m.group(1))
        for key, label in TUNING_ARRAYS.items():
            spec = self._vanilla_spec(label)
            if not spec: continue
            try:
                _a, _b, block = locate_vanilla_block(src, spec[1], spec[2])
                m = re.search(r"\{([^{}]*)\}", block, re.DOTALL)
                if not m: continue
                for i, value in enumerate(re.findall(r"-?\d+", m.group(1))):
                    k = "%s[%d]" % (key, i)
                    if k in self.tuning_vars: self.tuning_vars[k].set(value)
            except ValueError: pass
        self.tuning_base = {k: v.get().strip() for k, v in self.tuning_vars.items()}
        for k in self.tuning_vars: self._tuning_mark(k)

    def apply_tuning_values(self):
        if not self.require_source("Open a C++ source file first."): return
        if not self._vanilla_resolve_pending(): return
        staged = dict(self.vanilla_edits)
        try:
            source = strip_dev_patches(self.disk)
            def stage(label, new_text, original):
                if new_text.rstrip("\r\n") == original.rstrip("\r\n"): staged.pop(label, None)
                else: staged[label] = new_text
            for key, label in TUNING_SCALAR.items():
                value = int(self.tuning_vars[key].get())
                spec = self._vanilla_spec(label); _a, _b, original = locate_vanilla_block(source, spec[1], spec[2])
                current = staged.get(label, original)
                changed, count = re.subn(r"(\b" + re.escape(key) + r"\s*=\s*)-?\d+", lambda m: m.group(1) + str(value), current, count=1)
                if count != 1: raise ValueError("Could not locate numeric value for %s in %s." % (key, label))
                stage(label, changed, original)
            for key, label in TUNING_ARRAYS.items():
                spec = self._vanilla_spec(label); _a, _b, original = locate_vanilla_block(source, spec[1], spec[2])
                current = staged.get(label, original)
                values = [int(self.tuning_vars["%s[%d]" % (key, i)].get()) for i in range(sum(1 for n in self.tuning_vars if n.startswith(key + "[")))]
                m = re.search(r"(\{)([^{}]*)(\})", current, re.DOTALL)
                if not m: raise ValueError("Could not locate initializer for %s." % key)
                stage(label, current[:m.start()] + m.group(1) + ", ".join(str(v) for v in values) + m.group(3) + current[m.end():], original)
            candidate = apply_vanilla_edits(source, staged)
            errs = lexical_cpp_check(candidate)
            if errs: raise ValueError("Staged tuning failed structural validation: " + "; ".join(errs))
        except ValueError as e:
            messagebox.showerror("Tuning not applied", "Every field must be a whole number.\n\n%s" % e, parent=self); return
        except Exception as e:
            messagebox.showerror("Tuning not applied", str(e), parent=self); return
        if staged == self.vanilla_edits: self.flash("No tuning changes to stage."); return
        self.vanilla_edits = staged
        if self.current_vanilla_label: self.load_vanilla_block(self.current_vanilla_label, quiet=True)
        self.changed(); self.flash("Tuning staged. Review the diff (toolbar > Diff), then Save.")

    # ------------------------------------------------------------ 3. Mod content (tables)
    def _mods_tab(self, frame):
        ttk.Label(frame, text="Mod content is generated into the MOD ZONE of the open C++ source as plain data tables. It affects gameplay only after a runtime hook (5 Gameplay Patches) reads it. Table # numbers are the row indices other tables refer to.", wraplength=1100, style="Muted.TLabel").pack(anchor="w", padx=10, pady=(8, 2))
        bb = ttk.Frame(frame); bb.pack(fill="x", padx=10, pady=2)
        for text, cmd in (("Load bundle…", self.load_bundle), ("Save bundle…", self.save_bundle), ("Insert sample", self.insert_sample_bundle), ("Undo", self.undo_bundle)):
            ttk.Button(bb, text=text, command=cmd).pack(side="left", padx=(0, 4))
        self.bundle_label = ttk.Label(bb, text="", style="Muted.TLabel"); self.bundle_label.pack(side="left", padx=10)
        self.mod_nb = ttk.Notebook(frame); self.mod_nb.pack(fill="both", expand=True, padx=8, pady=6)
        for key, label in (("items", "Items"), ("enemies", "Enemies"), ("quests", "Quests"), ("dialogs", "Dialogue"), ("story", "Scenes & rumors"), ("flavor", "Flavor")):
            f = ttk.Frame(self.mod_nb); self.mod_nb.add(f, text=label); self.mod_tabs[key] = (f, label)
            if key == "items":
                ttk.Label(f, text="To change existing potions, spells or shop stock use 1 Existing Content. Items here are data until a runtime hook uses them.", style="Muted.TLabel").pack(anchor="w", padx=8, pady=(6, 0))
            if key == "story":
                pw = ttk.Panedwindow(f, orient="vertical"); pw.pack(fill="both", expand=True)
                for sk, cap in (("scenes", "Interludes (scenes)"), ("rumors", "Rumors")):
                    pane = ttk.Frame(pw); pw.add(pane, weight=1); ttk.Label(pane, text=cap, style="Head.TLabel").pack(anchor="w", padx=8, pady=(6, 0)); self._table_tab(pane, sk)
            else: self._table_tab(f, key)
        self._update_bundle_label()

    def _table_tab(self, frame, key):
        bar = ttk.Frame(frame); bar.pack(fill="x", padx=6, pady=(6, 2))
        for text, cmd, w in (("Add", lambda: self.add_row(key), 8), ("Edit", lambda: self.edit_row(key), 8), ("Duplicate", lambda: self.duplicate_row(key), 10),
                             ("Delete", lambda: self.delete_row(key), 8), ("▲", lambda: self.move_row(key, -1), 3), ("▼", lambda: self.move_row(key, 1), 3)):
            ttk.Button(bar, text=text, command=cmd, width=w).pack(side="left", padx=(0, 3))
        fv = tk.StringVar(); ttk.Entry(bar, textvariable=fv, width=22).pack(side="right"); ttk.Label(bar, text="Filter:").pack(side="right", padx=(8, 3))
        top = ttk.Frame(frame); top.pack(fill="both", expand=True, padx=6, pady=(0, 6))
        tree = ttk.Treeview(top, show="headings", selectmode="browse")
        vs = ttk.Scrollbar(top, orient="vertical", command=tree.yview); hs = ttk.Scrollbar(top, orient="horizontal", command=tree.xview)
        tree.configure(yscrollcommand=vs.set, xscrollcommand=hs.set)
        tree.grid(row=0, column=0, sticky="nsew"); vs.grid(row=0, column=1, sticky="ns"); hs.grid(row=1, column=0, sticky="ew")
        top.rowconfigure(0, weight=1); top.columnconfigure(0, weight=1)
        self.tables[key] = {"tree": tree, "cols": None, "filter": fv}
        fv.trace_add("write", lambda *_: self.refresh_table(key))
        def dbl(e):
            if tree.identify_region(e.x, e.y) == "cell": self.edit_row(key)
        tree.bind("<Double-1>", dbl); tree.bind("<Return>", lambda e: self.edit_row(key)); tree.bind("<Delete>", lambda e: self.delete_row(key))
        tree.bind("<Control-z>", lambda e: (self.undo_bundle(), "break")[1]); tree.bind("<Control-d>", lambda e: (self.duplicate_row(key), "break")[1])
        self.refresh_table(key)

    def _table_columns(self, key):
        if key == "flavor": return ("text",)
        cols = list(ROW_DEFAULTS.get(key, {}))
        for r in self.bundle.get(key, []):
            if isinstance(r, dict):
                for k in r:
                    if k not in cols: cols.append(k)
        return tuple(cols)

    def _selected_index(self, key):
        sel = self.tables[key]["tree"].selection()
        return int(sel[0]) if sel else None

    def _select_row(self, key, i):
        tree = self.tables[key]["tree"]
        if tree.exists(str(i)): tree.selection_set(str(i)); tree.see(str(i)); tree.focus(str(i))

    def refresh_table(self, key):
        info = self.tables.get(key)
        if not info: return
        tree = info["tree"]; rows = self.bundle.get(key, []); cols = self._table_columns(key)
        if cols != info["cols"]:
            tree.configure(columns=("idx",) + cols)
            tree.heading("idx", text="#"); tree.column("idx", width=42, minwidth=30, stretch=False, anchor="e")
            for c in cols:
                tree.heading(c, text=c); tree.column(c, width=300 if c in TEXT_FIELDS else 110, minwidth=40, stretch=True, anchor="w")
            info["cols"] = cols
        flt = info["filter"].get().strip().lower()
        prev = self._selected_index(key)
        tree.delete(*tree.get_children())
        for i, item in enumerate(rows):
            vals = [str(i)]
            for c in cols:
                v = item.get(c, "") if isinstance(item, dict) else (item if c == "text" else "")
                if isinstance(v, (dict, list)): v = json.dumps(v, ensure_ascii=False)
                vals.append(str(v)[:160])
            if flt and flt not in " ".join(vals).lower(): continue
            tree.insert("", "end", iid=str(i), values=vals)
        if prev is not None and tree.exists(str(prev)): tree.selection_set(str(prev))

    def refresh_all(self):
        for k in self.tables: self.refresh_table(k)
        for key, (f, label) in self.mod_tabs.items():
            n = sum(len(self.bundle.get(k, [])) for k in (("scenes", "rumors") if key == "story" else (key,)))
            self.mod_nb.tab(f, text="%s (%d)" % (label, n) if n else label)
        self._update_bundle_label()

    def _update_bundle_label(self):
        if hasattr(self, "bundle_label"):
            n = sum(len(self.bundle.get(k, [])) for k in SECTIONS)
            self.bundle_label.config(text="Bundle: %s — %d row(s)" % (self.bundle_file.name if self.bundle_file else "not saved to a file", n))

    def push_undo(self):
        self.bundle_history.append(copy.deepcopy(self.bundle)); del self.bundle_history[:-30]

    def undo_bundle(self):
        if not self.bundle_history: self.flash("Nothing to undo in mod data."); return
        self.bundle = self.bundle_history.pop(); self.changed(); self.refresh_all(); self.flash("Undid last mod-data change.")

    def _bundle_changed(self, key=None, select=None):
        self.changed(); self.refresh_all()
        if key and select is not None: self._select_row(key, select)

    def add_row(self, key):
        rows = self.bundle.setdefault(key, [])
        if key == "flavor":
            val = simpledialog.askstring("Add flavor", "Flavor line:", parent=self)
            if val is None: return
            self.push_undo(); rows.append(val); self._bundle_changed(key, len(rows) - 1); return
        def done(rec):
            self.push_undo(); self.bundle.setdefault(key, []).append(rec); self._bundle_changed(key, len(self.bundle[key]) - 1)
        RecordDialog(self, "Add " + SINGULAR[key], copy.deepcopy(ROW_DEFAULTS.get(key, {})), ROW_DEFAULTS.get(key, {}), done, RECORD_HINTS.get(key, ""))

    def edit_row(self, key):
        idx = self._selected_index(key)
        if idx is None: self.flash("Select a row first."); return
        old = self.bundle[key][idx]
        if isinstance(old, str):
            val = simpledialog.askstring("Edit flavor", "Flavor line:", initialvalue=old, parent=self)
            if val is not None: self.push_undo(); self.bundle[key][idx] = val; self._bundle_changed(key, idx)
            return
        def done(rec):
            self.push_undo(); self.bundle[key][idx] = rec; self._bundle_changed(key, idx)
        RecordDialog(self, "Edit %s #%d" % (SINGULAR[key], idx), copy.deepcopy(old), ROW_DEFAULTS.get(key, {}), done, RECORD_HINTS.get(key, ""))

    def duplicate_row(self, key):
        idx = self._selected_index(key)
        if idx is None: self.flash("Select a row first."); return
        item = copy.deepcopy(self.bundle[key][idx])
        if isinstance(item, dict):
            for k in ("key", "id"):
                if k in item: item[k] = str(item[k]) + "_copy"
            for k in ("name", "title"):
                if k in item: item[k] = str(item[k]) + " (copy)"; break
        self.push_undo(); self.bundle[key].append(item); self._bundle_changed(key, len(self.bundle[key]) - 1)

    def delete_row(self, key):
        idx = self._selected_index(key)
        if idx is None: self.flash("Select a row first."); return
        refs = count_refs(self.bundle, key, idx) if key in ("enemies", "dialogs") else 0
        msg = "Delete the selected %s (#%d)?" % (SINGULAR[key], idx)
        if refs: msg += "\n\n%d reference(s) to it in other tables will be cleared to -1, and later rows are renumbered." % refs
        elif key in ("enemies", "dialogs"): msg += "\n\nLater rows are renumbered and references to them are updated."
        if not messagebox.askyesno("Delete content", msg + "\n(Undo is available.)", parent=self): return
        n = len(self.bundle[key]); self.push_undo(); del self.bundle[key][idx]
        if key in ("enemies", "dialogs"): remap_bundle_refs(self.bundle, key, delete_mapping(n, idx))
        self._bundle_changed(key)

    def move_row(self, key, delta):
        idx = self._selected_index(key); rows = self.bundle.get(key, [])
        if idx is None: self.flash("Select a row first."); return
        j = idx + delta
        if not 0 <= j < len(rows): return
        self.push_undo(); rows[idx], rows[j] = rows[j], rows[idx]
        if key in ("enemies", "dialogs"): remap_bundle_refs(self.bundle, key, swap_mapping(idx, j))
        self._bundle_changed(key, j)

    # ------------------------------------------------------------ bundle files
    def _read_bundle(self, p):
        b = json.loads(Path(p).read_text(encoding="utf-8"))
        if not isinstance(b, dict): raise ValueError("A mod bundle must be a JSON object.")
        for k in SECTIONS:
            b.setdefault(k, [])
            if not isinstance(b[k], list): raise ValueError("%s must be a list" % k)
        return b

    def _write_bundle(self, p):
        payload = {"format": BUNDLE_FORMAT}; payload.update({k: v for k, v in self.bundle.items() if k != "format"})
        Path(p).write_text(json.dumps(payload, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")

    def load_bundle(self, path=None):
