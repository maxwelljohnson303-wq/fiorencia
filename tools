    def _log_output(self, value, tag=None):
        if not hasattr(self, "build_output"): return
        t = self.build_output; value = ANSI_RE.sub("", value)
        for line in value.splitlines(True):
            tg = tag
            if tg is None:
                m = DIAG_RE.match(line)
                if m: tg = "err" if "error" in m.group("kind") else "warn" if m.group("kind") == "warning" else "note"
            t.insert("end", line, (tg,) if tg else ())
        t.see("end")

    def _on_output_click(self, e):
        line = self.build_output.get("@%d,%d linestart" % (e.x, e.y), "@%d,%d lineend" % (e.x, e.y))
        m = DIAG_RE.match(line)
        if m and "workbench_build" in m.group("file"):
            if self._build_is_current(): self.goto_preview_line(int(m.group("line")))
            else: self.flash("Source changed since that build; line numbers may be off.", 8000); self.goto_preview_line(int(m.group("line")))

    def _history(self, step):
        if not self.game_history: return "break"
        self.game_hist_pos = max(0, min(len(self.game_history), self.game_hist_pos + step))
        self.game_input.set(self.game_history[self.game_hist_pos] if self.game_hist_pos < len(self.game_history) else ""); return "break"

    def _set_build_buttons(self, enabled):
        for b in (self.btn_release, self.btn_debug, self.btn_run, self.tb_build): b.state(["!disabled"] if enabled else ["disabled"])

    def build_game(self, debug=False, run_after=False):
        if not self.require_source(): return
        if self.build_running: self.flash("A build is already running."); return
        if self.proc and self.proc.poll() is None:
            if not messagebox.askyesno("Game running", "Stop the running game and rebuild?", parent=self): return
            self.stop_process()
            try: self.proc.wait(timeout=2)
            except Exception: pass
        if not self._vanilla_resolve_pending(): return
        src, err = self.get_preview()
        if err: messagebox.showerror("Build blocked", "Preview failed:\n" + err, parent=self); return
        errors = self.get_validation()
        if errors:
            self.select_tab("review")
            messagebox.showerror("Validation failed", "Fix these before building:\n\n" + "\n".join(errors[:12]) + ("\n…" if len(errors) > 12 else "") + "\n\nSee the Review tab for hints.", parent=self); return
        if not shutil.which("g++"):
            messagebox.showerror("g++ not found", "g++ is not on PATH.\nInstall a C++17 compiler (MinGW-w64 / MSYS2 on Windows, build-essential on Linux, Xcode tools on macOS) and restart the workbench.", parent=self); return
        self.select_tab("build"); self.run_after_build = run_after
        temp_src = self.path.with_name(self.path.stem + ".workbench_build.cpp")
        exe_path = self.path.with_name(self.path.stem + (".debug" if debug else ".dev") + (".exe" if os.name == "nt" else ""))
        try: temp_src.write_bytes(src.encode("utf-8"))
        except Exception as e: messagebox.showerror("Build failed to start", str(e), parent=self); return
        if debug: cmd = ["g++", "-std=c++17", "-O0", "-g", str(temp_src), "-o", str(exe_path)]
        else: cmd = ["g++", "-std=c++17", "-Os", "-s", "-fno-exceptions", "-fno-rtti", "-ffunction-sections", "-fdata-sections", str(temp_src), "-Wl,--gc-sections", "-o", str(exe_path)]
        self._log_output("\n$ " + " ".join(shlex.quote(x) for x in cmd) + "\n", "cmd")
        self.build_running = True; self.built_binary = None; self._set_build_buttons(False); self.update_status()
        digest = hashlib.sha1(src.encode("utf-8")).hexdigest(); cwd = str(self.path.parent); flags = getattr(subprocess, "CREATE_NO_WINDOW", 0)
        def worker():
            started = time.time()
            try:
                r = subprocess.run(cmd, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=180, creationflags=flags)
                text = r.stdout.decode("utf-8", "replace")
                self.output_queue.put(("log", text or "(no compiler output)\n"))
                diags = [DIAG_RE.match(ln) for ln in text.splitlines()]
                ne = sum(1 for m in diags if m and "error" in m.group("kind"))
                nw = sum(1 for m in diags if m and m.group("kind") == "warning")
                self.output_queue.put(("build_done", r.returncode == 0, r.returncode, str(exe_path), digest, debug, ne, nw, time.time() - started, str(temp_src)))
            except Exception as exc:
                self.output_queue.put(("log", "\nBUILD ERROR: %s\n" % exc)); self.output_queue.put(("build_done", False, -1, str(exe_path), digest, debug, 0, 0, time.time() - started, str(temp_src)))
        threading.Thread(target=worker, daemon=True).start()

    def _on_build_done(self, ok, rc, exe, digest, debug, nerr, nwarn, secs, temp):
        self.build_running = False; self._set_build_buttons(True)
        if ok:
            self.built_binary = Path(exe); self.build_hash = digest; self.build_state = "Build OK"
            self._log_output("\nBUILD OK in %.1fs (%d warning(s)): %s\n" % (secs, nwarn, exe), "ok")
            if not debug:
                try: Path(temp).unlink()
                except OSError: pass
        else:
            self.build_state = "Build failed"
            self._log_output("\nBUILD FAILED (exit %s): %d error(s), %d warning(s). Double-click an error line to jump to it.\n" % (rc, nerr, nwarn), "err")
        self.update_status()
        if ok and self.run_after_build: self.launch_game(skip_stale_check=True)
        self.run_after_build = False

    def launch_game(self, skip_stale_check=False):
        if self.proc and self.proc.poll() is None: messagebox.showwarning("Already running", "A game process is already running.", parent=self); return
        binary = self.built_binary
        if not binary or not Path(binary).exists(): messagebox.showinfo("No build", "Build Release or Build Debug first (F5).", parent=self); return
        if not skip_stale_check and not self._build_is_current():
            if not messagebox.askyesno("Build is older than your edits", "The built binary does not include your latest changes. Launch it anyway?", parent=self): return
        try:
            args = shlex.split(self.run_args.get(), posix=(os.name != "nt")); cmd = [str(binary)] + args
            self.select_tab("build"); self._log_output("\n$ " + " ".join(shlex.quote(x) for x in cmd) + "\n", "cmd")
            self.proc = subprocess.Popen(cmd, cwd=str(self.path.parent), stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, bufsize=0, creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
            def reader(proc):
                dec = codecs.getincrementaldecoder("utf-8")(errors="replace")
                try:
                    while True:
                        chunk = os.read(proc.stdout.fileno(), 4096)
                        if not chunk: break
                        self.output_queue.put(("log", dec.decode(chunk)))
                    self.output_queue.put(("log", "\nGAME EXITED (code %s).\n" % proc.wait()))
                except Exception as exc: self.output_queue.put(("log", "\nGAME OUTPUT ERROR: %s\n" % exc))
            threading.Thread(target=reader, args=(self.proc,), daemon=True).start()
        except Exception as e: messagebox.showerror("Launch failed", str(e), parent=self)

    def send_game_input(self, text=None):
        if not self.proc or self.proc.poll() is not None or not self.proc.stdin: messagebox.showinfo("No running game", "Launch the built game first (F7).", parent=self); return
        text = self.game_input.get() if text is None else text
        try:
            self.proc.stdin.write((text + "\n").encode("utf-8")); self.proc.stdin.flush()
            self._log_output("« %s\n" % text, "cmd")
            if text and (not self.game_history or self.game_history[-1] != text): self.game_history.append(text)
            self.game_hist_pos = len(self.game_history); self.game_input.set("")
        except Exception as e: messagebox.showerror("Input failed", str(e), parent=self)

    def stop_process(self):
        if self.proc and self.proc.poll() is None: self.proc.terminate(); self._log_output("\nTermination requested.\n", "note")

    def _poll_process_output(self):
        try:
            while True:
                item = self.output_queue.get_nowait()
                if item[0] == "log": self._log_output(item[1])
                elif item[0] == "build_done": self._on_build_done(*item[1:])
        except queue.Empty: pass
        if self.winfo_exists(): self.after(100, self._poll_process_output)

