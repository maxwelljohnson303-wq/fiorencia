    def _review_tab(self, frame):
        ttk.Label(frame, text="Pending changes, validation results (with fix hints) and feature dependencies. Readiness labels describe evidence available in this workbench, not proof of gameplay correctness.", wraplength=1080, style="Muted.TLabel").pack(anchor="w", padx=10, pady=(10, 5))
        row = ttk.Frame(frame); row.pack(fill="x", padx=10, pady=4)
        for text, cmd in (("Refresh", lambda: self.refresh_review(force=True)), ("Structural self-test of file on disk", self.run_selftest_ui), ("Copy report", self.copy_review)):
            ttk.Button(row, text=text, command=cmd).pack(side="left", padx=(0, 5))
        fr, self.review_text = scrolled_text(frame, wrap="word", font=("TkFixedFont", 9), state="disabled"); fr.pack(fill="both", expand=True, padx=10, pady=5)
