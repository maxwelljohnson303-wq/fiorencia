        del self.designs[int(sel[0])]; self.design_dirty = True; self.refresh_design_tree(); self.new_item_design(); self._update_title(); self.refresh_review(); self.update_status()

    def refresh_design_tree(self):
        if not hasattr(self, "design_tree"): return
        self.design_tree.delete(*self.design_tree.get_children())
        for i, d in enumerate(self.designs): self.design_tree.insert("", "end", iid=str(i), values=(d.get("type", ""), d.get("name", ""), "Design only"))

    def refresh_design_checklist(self, design=None):
        if not hasattr(self, "design_checklist"): return
        d = design or self._design_record_from_form()
        lines = ["Item: %s [%s]" % (d.get("name", "(unnamed)"), d.get("key", "no-id")), "[ ] Define or reuse a runtime effect handler for: " + d.get("effect", "unspecified effect"), "[ ] Connect item identity and effect to the game's actual item/use logic"]
        by_type = {
            "Consumable": ["[ ] Connect to inventory quantity and consumption rules", "[ ] Handle insufficient/maximum HP or SP and report the result"],
            "Weapon": ["[ ] Integrate weapon selection, damage roll, and combat display", "[ ] Check equipment persistence and legacy-save defaults"],
            "Armor": ["[ ] Integrate armor selection and defense calculations", "[ ] Check equipment persistence and legacy-save defaults"],
            "Spell": ["[ ] Integrate spell list, SP cost, accuracy, target, and combat resolution", "[ ] Update spell information/status displays and backward-compatible ownership persistence"],
            "Quest item": ["[ ] Define acquisition, quest checks, consumption/retention, and completion paths", "[ ] Check quest flags and save/load behavior"],
            "Magical item": ["[ ] Decide whether effect is passive, activated, timed, or conditional", "[ ] Integrate the chosen trigger, effect handler, and persistence if stateful"]}
        lines += by_type.get(d.get("type", "Consumable"), [])
        if d.get("shop"): lines.append("[ ] Add to shop inventory and purchasing/display logic (price: %s %s)" % (d.get("price", "?"), d.get("currency", "")))
        if d.get("quest_reward"): lines.append("[ ] Add quest reward grant path and duplicate/repeat-claim rules")
        if d.get("secondary_effect"): lines.append("[ ] Implement and test secondary effect: %s (%s%% chance; %s turns)" % (d.get("secondary_effect", ""), d.get("chance_pct", 0), d.get("duration_turns", 0)))
        if d.get("nighteye"): lines.append("[ ] Locate Potion of Nighteye encounter selection and add the availability condition")
        lines += ["[ ] Review generated source diff", "[ ] Compile with the game's documented C++ flags", "[ ] Test acquisition, use, edge cases, save/reload, and removal/failure paths", "", "Readiness: DESIGN ONLY until all required integration tasks are implemented and tested."]
        w = self.design_checklist; w.configure(state="normal"); w.delete("1.0", "end"); w.insert("1.0", "\n".join(lines)); w.configure(state="disabled")

    def _design_tasks(self, d):
        tasks = ["Define/reuse effect handler", "Connect identity to runtime item logic"]
        t = d.get("type")
        if t == "Spell": tasks += ["Integrate casting, SP cost, target, and combat resolution", "Update displays and backward-compatible save persistence"]
        elif t == "Consumable": tasks += ["Connect use and inventory quantity logic"]
        elif t == "Weapon": tasks += ["Connect weapon damage and combat display"]
        elif t == "Armor": tasks += ["Connect armor selection and defense calculations"]
        if d.get("shop"): tasks.append("Connect shop listing and purchase path")
        if d.get("quest_reward"): tasks.append("Connect quest reward grant path")
        if d.get("secondary_effect"): tasks.append("Implement secondary effect, chance, and duration")
        if d.get("nighteye"): tasks.append("Connect Potion of Nighteye encounter availability")
        return tasks + ["Review diff, compile, and perform gameplay/save tests"]

