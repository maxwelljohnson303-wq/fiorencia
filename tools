class RecordDialog(tk.Toplevel):
    """Form editor for one mod-data record, with a raw-JSON escape hatch. Field types follow the record."""
    def __init__(self, parent, title, record, defaults, on_apply, hint=""):
        super().__init__(parent)
        self.title(title); self.transient(parent); self.geometry("780x660")
        self.defaults, self.on_apply, self.mode = defaults, on_apply, "form"
        self.vars, self.kinds, self.texts = {}, {}, {}
        if hint: ttk.Label(self, text=hint, style="Muted.TLabel", wraplength=740, justify="left").pack(anchor="w", padx=10, pady=(8, 2))
        self.holder = ttk.Frame(self); self.holder.pack(fill="both", expand=True, padx=8, pady=4)
        self.form_box = ttk.Frame(self.holder)
        self.canvas = tk.Canvas(self.form_box, highlightthickness=0)
        sb = ttk.Scrollbar(self.form_box, orient="vertical", command=self.canvas.yview)
        self.canvas.configure(yscrollcommand=sb.set)
        sb.pack(side="right", fill="y"); self.canvas.pack(side="left", fill="both", expand=True)
        self.form = ttk.Frame(self.canvas); self.form.columnconfigure(1, weight=1)
        self.canvas.create_window((0, 0), window=self.form, anchor="nw", tags=("form",))
        self.form.bind("<Configure>", lambda e: self.canvas.configure(scrollregion=self.canvas.bbox("all")))
        self.canvas.bind("<Configure>", lambda e: self.canvas.itemconfigure("form", width=e.width))
        self.json_box, self.json_text = scrolled_text(self.holder, font=("TkFixedFont", 10), undo=True)
        self.form_box.pack(fill="both", expand=True)
        row = ttk.Frame(self); row.pack(fill="x", padx=8, pady=8)
        ttk.Button(row, text="Cancel", command=self.destroy).pack(side="right")
        ttk.Button(row, text="Apply (Ctrl+Enter)", command=self.apply).pack(side="right", padx=5)
        self.toggle_btn = ttk.Button(row, text="Edit as JSON", command=self.toggle_mode); self.toggle_btn.pack(side="left")
        ttk.Button(row, text="Reset to defaults", command=self.reset_defaults).pack(side="left", padx=5)
        self._build_form(record)
        self.bind("<Control-Return>", lambda e: (self.apply(), "break")[1]); self.bind("<Escape>", lambda e: self.destroy())
        for seq in ("<MouseWheel>", "<Button-4>", "<Button-5>"): self.bind_all(seq, self._on_wheel)
        self.bind("<Destroy>", self._on_destroy)
        self.after(60, self._grab)

    def _grab(self):
        try: self.grab_set(); self.focus_set()
        except tk.TclError: pass

    def _on_destroy(self, e):
        if e.widget is self:
            for seq in ("<MouseWheel>", "<Button-4>", "<Button-5>"): self.unbind_all(seq)

    def _on_wheel(self, e):
        if self.mode != "form": return
        step = -1 if (e.num == 4 or (e.num not in (4, 5) and e.delta > 0)) else 1
        self.canvas.yview_scroll(step, "units")

    def _build_form(self, rec):
        for w in self.form.winfo_children(): w.destroy()
        self.vars, self.kinds, self.texts = {}, {}, {}
        keys = [k for k in self.defaults if k in rec] + [k for k in rec if k not in self.defaults]
        for r, k in enumerate(keys):
            v = rec[k]
            ttk.Label(self.form, text=k, width=16, anchor="w").grid(row=r, column=0, sticky="nw", padx=(2, 6), pady=3)
            if isinstance(v, bool):
                var = tk.BooleanVar(value=v); ttk.Checkbutton(self.form, variable=var).grid(row=r, column=1, sticky="w"); kind = "bool"
            elif isinstance(v, int):
                var = tk.StringVar(value=str(v)); ttk.Entry(self.form, textvariable=var).grid(row=r, column=1, sticky="ew"); kind = "int"
            elif isinstance(v, float):
                var = tk.StringVar(value=str(v)); ttk.Entry(self.form, textvariable=var).grid(row=r, column=1, sticky="ew"); kind = "float"
            elif isinstance(v, str):
                kind = "str"; var = tk.StringVar(value=v)
                if k in TEXT_FIELDS:
                    t = tk.Text(self.form, height=3, wrap="word", font=("TkDefaultFont", 9)); t.insert("1.0", v)
                    t.grid(row=r, column=1, sticky="ew"); self.texts[k] = t
                else: ttk.Entry(self.form, textvariable=var).grid(row=r, column=1, sticky="ew")
            else:
                kind = "json"; var = tk.StringVar(value=json.dumps(v, ensure_ascii=False))
                ttk.Entry(self.form, textvariable=var).grid(row=r, column=1, sticky="ew")
            self.vars[k], self.kinds[k] = var, kind

    def _collect_form(self):
        rec, errs = {}, []
        for k, kind in self.kinds.items():
            raw = self.vars[k].get()
            if kind == "bool": rec[k] = bool(raw)
            elif kind == "str": rec[k] = self.texts[k].get("1.0", "end-1c") if k in self.texts else raw
            elif kind in ("int", "float"):
                try: rec[k] = int(str(raw).strip()) if kind == "int" else float(str(raw).strip())
                except ValueError: errs.append("%s: %s required" % (k, "whole number" if kind == "int" else "number"))
            else:
                try: rec[k] = json.loads(raw)
                except ValueError as e: errs.append("%s: invalid JSON (%s)" % (k, e))
        return rec, errs

    def _collect_json(self):
        try:
            val = json.loads(self.json_text.get("1.0", "end-1c"))
            if not isinstance(val, dict): raise ValueError("record must be a JSON object")
            return val, []
        except ValueError as e:
            return None, ["JSON: " + str(e)]

    def toggle_mode(self):
        if self.mode == "form":
            rec, errs = self._collect_form()
            if errs: messagebox.showerror("Fix these fields", "\n".join(errs), parent=self); return
            self.form_box.pack_forget(); self.json_box.pack(fill="both", expand=True)
            self.json_text.delete("1.0", "end"); self.json_text.insert("1.0", json.dumps(rec, indent=2, ensure_ascii=False))
            self.mode = "json"; self.toggle_btn.config(text="Edit as form")
        else:
            rec, errs = self._collect_json()
            if errs: messagebox.showerror("Invalid JSON", "\n".join(errs), parent=self); return
            self._build_form(rec); self.json_box.pack_forget(); self.form_box.pack(fill="both", expand=True)
            self.mode = "form"; self.toggle_btn.config(text="Edit as JSON")

    def reset_defaults(self):
        if not self.defaults: return
        rec = copy.deepcopy(self.defaults)
        if self.mode == "form": self._build_form(rec)
        else: self.json_text.delete("1.0", "end"); self.json_text.insert("1.0", json.dumps(rec, indent=2, ensure_ascii=False))

    def apply(self):
        rec, errs = self._collect_form() if self.mode == "form" else self._collect_json()
        if errs: messagebox.showerror("Cannot apply", "\n".join(errs), parent=self); return
        self.on_apply(rec); self.destroy()


