# ---------------------------------------------------------------- pure helpers
def read_source_text(path):
    """Return (LF-normalised text, original eol, raw bytes). Line endings are restored on save."""
    raw = Path(path).read_bytes()
    text = raw.decode("utf-8")
    return text.replace("\r\n", "\n"), ("\r\n" if "\r\n" in text else "\n"), raw


def to_disk_text(text, eol):
    return text.replace("\n", eol) if eol != "\n" else text


def iter_refs(bundle, kind):
    """Yield (container, key) for every cross-table index that points at `kind` rows."""
    if kind == "enemies":
        for q in bundle.get("quests", []):
            if isinstance(q, dict) and "enemyIdx" in q: yield q, "enemyIdx"
    elif kind == "dialogs":
        for sec in ("quests", "scenes"):
            for r in bundle.get(sec, []):
                if isinstance(r, dict) and "dialogIdx" in r: yield r, "dialogIdx"
        for dlg in bundle.get("dialogs", []):
            nx = dlg.get("next") if isinstance(dlg, dict) else None
            if isinstance(nx, list):
                for k in range(len(nx)): yield nx, k


def _as_int(v):
    try: return int(v)
    except (TypeError, ValueError): return None


def count_refs(bundle, kind, idx):
    return sum(1 for c, k in iter_refs(bundle, kind) if _as_int(c[k]) == idx)


def remap_bundle_refs(bundle, kind, mapping):
    """mapping: old row -> new row (None = row deleted -> reference cleared to -1). Returns #refs changed."""
    changed = 0
    for c, k in list(iter_refs(bundle, kind)):
        v = _as_int(c[k])
        if v is None or v < 0 or v not in mapping: continue
        nv = mapping[v]
        nv = -1 if nv is None else nv
        if nv != v: c[k] = nv; changed += 1
    return changed


def delete_mapping(n, idx):
    return {i: (None if i == idx else (i - 1 if i > idx else i)) for i in range(n)}


def swap_mapping(i, j):
    return {i: j, j: i}


def diff_counts(text):
    a = d = 0
    for ln in text.splitlines():
        if ln.startswith("+") and not ln.startswith("+++"): a += 1
        elif ln.startswith("-") and not ln.startswith("---"): d += 1
    return a, d


def hint_for(err):
    e = err.lower()
    if "banned c++" in e or "forbidden construct" in e:
        return "Remove try/catch/throw, <iostream>/<fstream>/<sstream>, stoi-style calls or .at(). See BUILD NOTES at the top of the currently open C++ source."
    if "scene" in e and "plot must be" in e: return "Scenes use plot 0 (revolt), 1 (plague) or 2 (Albizzi)."
    if "dialogidx out of range" in e or "next index" in e:
        return "Open Mod Content > Dialogue and use the # column: indices are row numbers; -1 ends a conversation."
    if "enemyidx out of range" in e: return "Open Mod Content > Enemies and use the # column; -1 means no enemy."
    if "plot bitmask" in e: return "Enemy plot is a bitmask in the range 0..7."
    if "anchor must occur exactly once" in e: return "Edit the anchor in Gameplay Patches and use 'Check anchor' to see how often it matches."
    if "unclosed delimiter" in e or "unexpected" in e:
        return "Check braces/parentheses in your Existing Content edits or patch code; Preview / Diff shows the generated source."
    if "unterminated" in e: return "A string, character literal or /* comment is not closed."
    if "modpatch" in e: return "Each // [MODPATCH:id] marker may appear only once."
    if "mod-zone" in e or "mod zone" in e: return "The MOD ZONE BEGIN / END comment lines must each appear exactly once."
    if "duplicate development patch" in e: return "Give every gameplay patch a unique ID."
    return ""


