    def _item_design_errors(self, design):
        errors = []
        if not re.fullmatch(r"[A-Za-z][A-Za-z0-9_]{1,47}", design["key"]): errors.append("ID must start with a letter and contain only letters, numbers and underscores (2–48 characters).")
        if not design["name"]: errors.append("Display name is required.")
        if not design["effect"]: errors.append("Effect / behavior is required.")
        try:
            if not 0 <= int(design["magnitude"]) <= 100000: errors.append("Effect magnitude must be between 0 and 100000.")
        except ValueError: errors.append("Effect magnitude must be a whole number.")
        for field, label, low, high in (("chance_pct", "Secondary chance", 0, 100), ("duration_turns", "Duration", 0, 10000), ("sp_cost", "SP cost", 0, 100000)):
            try:
                if not low <= int(design.get(field, "0")) <= high: errors.append("%s must be between %d and %d." % (label, low, high))
            except ValueError: errors.append("%s must be a whole number." % label)
        if design.get("accuracy"):
            try:
                if not 0 <= int(design["accuracy"]) <= 100: errors.append("Accuracy must be between 0 and 100.")
            except ValueError: errors.append("Accuracy must be a whole number or blank.")
        if design["shop"]:
            try:
                if not 0 <= int(design["price"]) <= 100000000: errors.append("Shop price must be between 0 and 100000000.")
            except ValueError: errors.append("Shop price must be a whole number when shop availability is enabled.")
        if any(d.get("key") == design["key"] for i, d in enumerate(self.designs) if i != self.current_design_index): errors.append("This ID is already used by another saved design.")
        return errors

    def save_item_design(self):
        design = self._design_record_from_form(); errors = self._item_design_errors(design)
        if errors: messagebox.showerror("Design not saved", "\n".join(errors), parent=self); return
        if self.current_design_index is None: self.designs.append(design); self.current_design_index = len(self.designs) - 1
        else: self.designs[self.current_design_index] = design
        self.design_dirty = True; self.refresh_design_tree(); self._update_title(); self.update_status(); self.refresh_review()
        self.design_tree.selection_set(str(self.current_design_index)); self.design_tree.see(str(self.current_design_index))
        self.flash("Design '%s' staged. Ctrl+S saves designs beside the source." % design["name"])

    def duplicate_item_design(self):
        sel = self.design_tree.selection()
        if not sel: self.flash("Select a design first."); return
        d = copy.deepcopy(self.designs[int(sel[0])]); base = d["key"] + "_copy"; key, n = base, 2
        while any(x.get("key") == key for x in self.designs): key = "%s%d" % (base, n); n += 1
        d["key"] = key; d["name"] = d.get("name", "") + " (copy)"; self.designs.append(d); self.design_dirty = True
        self.refresh_design_tree(); self._update_title(); self.update_status(); self.design_tree.selection_set(str(len(self.designs) - 1))

